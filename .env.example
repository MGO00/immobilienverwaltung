# Vorlage für .env.local. Diese Datei hier enthält keine echten Werte und darf
# committet werden. .env.local selbst ist über .gitignore ausgeschlossen und
# wird nie ins Repository übernommen.
#
# Werte aus dem Supabase-Dashboard: Project Settings -> API
#   NEXT_PUBLIC_SUPABASE_URL      = "Project URL"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = "anon public" Key
#
# Den service_role-Key hier NIE eintragen (siehe CLAUDE.md, Sicherheit und Datenschutz).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
