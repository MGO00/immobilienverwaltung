# Vorlage für .env.local. Diese Datei hier enthält keine echten Werte und darf
# committet werden. .env.local selbst ist über .gitignore ausgeschlossen und
# wird nie ins Repository übernommen.
#
# Werte aus dem Supabase-Dashboard: Project Settings -> API
#   NEXT_PUBLIC_SUPABASE_URL      = "Project URL"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = "anon public" Key
#
# Den Secret-/service_role-Key NIE mit NEXT_PUBLIC_ benennen und nie ins Frontend geben. Er wird
# nur serverseitig in src/lib/supabase/admin.ts gelesen und ist genau für zwei Funktionen
# freigegeben: die E-Mail-Liste der Startseite und die Kontolöschung in den Einstellungen.
# Siehe CLAUDE.md, Sicherheit und Datenschutz.
#
# SUPABASE_SECRET_KEY (Project Settings -> API Keys -> Secret, beginnt mit sb_secret_):
# ohne ihn ist die Kontolöschung nicht verfügbar (die Einstellungen zeigen dann einen Hinweis).
#
# E-Mail-Liste der Startseite (optional). Die Karte erscheint nur, wenn SUPABASE_SECRET_KEY,
# SMTP_HOST und MAIL_FROM gesetzt sind (dazu die ohnehin nötige NEXT_PUBLIC_SUPABASE_URL).
# MAIL_FROM ist der Absender, z. B. "Immobilienverwaltung <hallo@deine-domain.de>". SMTP_PORT (Standard 587),
# SMTP_USER und SMTP_PASSWORD je nach Anbieter. Vor dem Einschalten muss die
# Datenschutzerklärung stehen.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

SUPABASE_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
